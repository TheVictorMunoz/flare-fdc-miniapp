# ---- Flare Data Connector verifier (server-side only) ----
# The FDC testnet verifier server encodes attestation requests.
# Get a free testnet API key from the Flare team / dev hub.
# Docs: https://dev.flare.network/fdc/getting-started
VERIFIER_API_KEY_TESTNET=00000000-0000-0000-0000-000000000000

# Base URL of the testnet verifier server (default is Flare's public one).
WEB2JSON_VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network/

# Coston2 Data Availability layer (serves Merkle proofs once a round finalizes).
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network/

# Coston2 RPC endpoint used by the server routes for read calls.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
